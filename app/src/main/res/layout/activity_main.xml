<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#ffffff">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_promo" />
        </FrameLayout>

        <!-- אזור כפתורים עם Scroll אופקי -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal"
            android:layoutDirection="rtl"
            android:padding="8dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layoutDirection="rtl">

                <Button
                    android:id="@+id/login_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp"
                    android:backgroundTint="#6366F1"
                    android:text="@string/connect"
                    android:textColor="#ffffff" />

                <Button
                    android:id="@+id/user_profile_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp"
                    android:backgroundTint="#34D399"
                    android:text="@string/personal_area"
                    android:textColor="#ffffff" />

                <!-- כפתור עגלה עם מונה -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp">

                    <Button
                        android:id="@+id/cart_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#FFD700"
                        android:text="@string/cart"
                        android:textColor="#ffffff" />

                    <TextView
                        android:id="@+id/cart_counter"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/red_circle_background"
                        android:backgroundTint="#FF0000"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:visibility="gone"
                        android:elevation="4dp"
                        android:includeFontPadding="false"
                        android:padding="2dp" />
                </FrameLayout>


                <Button
                    android:id="@+id/categories_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp"
                    android:backgroundTint="#FF6347"
                    android:text="@string/categories"
                    android:textColor="#ffffff" />

                <Button
                    android:id="@+id/promotions_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp"
                    android:backgroundTint="#32CD32"
                    android:text="@string/sales_button"
                    android:textColor="#ffffff" />

                <Button
                    android:id="@+id/search_players_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp"
                    android:backgroundTint="#00BFFF"
                    android:text="@string/search_for_player"
                    android:textColor="#ffffff" />
            </LinearLayout>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@android:drawable/editbox_background"
            android:hint="@string/search_item"
            android:padding="14dp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:textDirection="rtl"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_home_products"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:clipToPadding="false"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
