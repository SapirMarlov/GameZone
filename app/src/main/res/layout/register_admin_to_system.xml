<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6"
    android:gravity="center"
    android:layoutDirection="rtl">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2D3748"
        android:padding="12dp"
        android:layoutDirection="rtl">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamezone"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_gravity="center" />
        </FrameLayout>
    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:padding="16dp"
        android:text="@string/הרשמה"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/custom_container"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="32dp"
        android:orientation="vertical"
        android:gravity="center"
        android:elevation="8dp"
        android:backgroundTint="#E2E8F0"
        android:layout_centerInParent="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/הרשמה_למערכת"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="24dp"
            android:gravity="center"/>

        <!-- שם משתמש -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#CBD5E1"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="18sp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/reg_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/שם_משתמש_הרשמה"
                android:textColorHint="#64748B"
                android:gravity="right"
                android:layoutDirection="rtl"/>
        </LinearLayout>

        <!-- בחירת תפקיד -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#CBD5E1"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎭"
                android:textSize="18sp"
                android:layout_marginEnd="8dp"/>

            <Spinner
                android:id="@+id/reg_userRole"
                android:hint="@string/תפקיד"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:textAlignment="textEnd"/>
        </LinearLayout>

        <!-- אימייל -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#CBD5E1"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉️"
                android:textSize="18sp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/reg_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/אימייל_הרשמה"
                android:inputType="textEmailAddress"
                android:textColorHint="#64748B"
                android:gravity="right"
                android:layoutDirection="rtl"/>
        </LinearLayout>

        <!-- סיסמה -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#CBD5E1"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="18sp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/reg_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/סיסמה_הרשמה"
                android:inputType="textPassword"
                android:textColorHint="#64748B"
                android:gravity="right"
                android:layoutDirection="rtl"/>
        </LinearLayout>

        <Button
            android:id="@+id/register_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/כפתור_הרשמה"
            android:textColor="@android:color/white"
            android:backgroundTint="#059669"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="6dp"
            android:gravity="center"/>
    </LinearLayout>
</RelativeLayout>