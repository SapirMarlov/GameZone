                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:text="120"
                        android:textColor="#000"
                        android:textSize="16sp" />
                </TableRow>

                <TableRow android:layout_height="43dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="right"
                        android:text="מקלדת "
                        android:textColor="#000"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
